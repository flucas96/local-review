{
  "name": "local-review",
  "displayName": "Local Review",
  "description": "Review local changes with Claude Code using native inline comments and automatic feedback delivery.",
  "version": "0.4.9",
  "icon": "resources/icon.png",
  "galleryBanner": { "color": "#101B29", "theme": "dark" },
  "publisher": "local-review-dev",
  "private": true,
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/flucas96/local-review.git" },
  "homepage": "https://github.com/flucas96/local-review#readme",
  "bugs": { "url": "https://github.com/flucas96/local-review/issues" },
  "engines": { "vscode": "^1.100.0", "node": ">=22" },
  "categories": ["Other"],
  "main": "./dist/extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "extensionDependencies": ["vscode.git"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Local Review connects to a coding agent that can edit workspace files." },
    "virtualWorkspaces": { "supported": false }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node scripts/test.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "1.32.1" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "contributes": {
    "colors": [
      {
        "id": "localReview.selectionBackground",
        "description": "Hintergrund der fixierten Codeauswahl für den aktiven Review-Kommentar.",
        "defaults": { "dark": "#5DB9C326", "light": "#087D8B1F", "highContrast": "#00000000", "highContrastLight": "#00000000" }
      },
      {
        "id": "localReview.selectionBorder",
        "description": "Rahmen der fixierten Codeauswahl für den aktiven Review-Kommentar.",
        "defaults": { "dark": "#83D6D8AA", "light": "#247D8FAA", "highContrast": "#FFFFFF", "highContrastLight": "#000000" }
      }
    ],
    "commands": [
      { "command": "localReview.startClaude", "title": "Mit Claude verbinden", "category": "Local Review", "icon": "$(plug)" },
      { "command": "localReview.copyClaudeCommand", "title": "Verbindungsbefehl kopieren", "category": "Local Review", "icon": "$(terminal)" },
      { "command": "localReview.addComment", "title": "Kommentar hinzufügen", "category": "Local Review", "icon": "$(comment-add)" },
      { "command": "localReview.openComposer", "title": "Feedback in Seitenansicht schreiben", "category": "Local Review", "icon": "$(open-preview)" },
      { "command": "localReview.openCode", "title": "Code im Editor öffnen", "category": "Local Review", "icon": "$(go-to-file)" },
      { "command": "localReview.openCommentCode", "title": "Code im Editor öffnen", "category": "Local Review", "icon": "$(go-to-file)" },
      { "command": "localReview.submitInline", "title": "Senden", "category": "Local Review", "enablement": "!commentIsEmpty" },
      { "command": "localReview.cancelDraft", "title": "Entwurf verwerfen", "category": "Local Review", "icon": "$(close)" },
      { "command": "localReview.openChanges", "title": "Änderungen reviewen", "category": "Local Review", "icon": "$(git-compare)" },
      { "command": "localReview.revealThread", "title": "Zum Kommentar springen", "category": "Local Review" },
      { "command": "localReview.composeReply", "title": "In Seitenansicht antworten", "category": "Local Review", "icon": "$(open-preview)" },
      { "command": "localReview.resumeDraft", "title": "Entwurf fortsetzen", "category": "Local Review", "icon": "$(edit)" },
      { "command": "localReview.exportToPr", "title": "An GitHub-PR übergeben", "category": "Local Review", "icon": "$(git-pull-request)" },
      { "command": "localReview.resolve", "title": "Als erledigt markieren", "category": "Local Review", "icon": "$(check)" },
      { "command": "localReview.showResolved", "title": "Erledigte anzeigen", "category": "Local Review", "icon": "$(eye)" },
      { "command": "localReview.hideResolved", "title": "Erledigte ausblenden", "category": "Local Review", "icon": "$(eye-closed)" },
      { "command": "localReview.enhanceContrast", "title": "Kommentarfenster hervorheben", "category": "Local Review", "icon": "$(color-mode)" },
      { "command": "localReview.toggleCenteredLayout", "title": "Zentrierte Ansicht", "category": "Local Review", "icon": "$(layout-centered)" },
      { "command": "localReview.resetContrast", "title": "Standarddarstellung wiederherstellen", "category": "Local Review", "icon": "$(discard)" },
      { "command": "localReview.reopen", "title": "Wieder öffnen", "category": "Local Review", "icon": "$(debug-restart)" }
    ],
    "views": { "scm": [{ "id": "localReview.threads", "name": "Review", "icon": "resources/review.svg" }] },
    "viewsWelcome": [{
      "view": "localReview.threads",
      "contents": "Feedback direkt an Claude Code.\n[Mit Claude verbinden](command:localReview.startClaude)\n[Änderungen reviewen](command:localReview.openChanges)\nMarkiere Code und füge einen Kommentar hinzu. Abgeschickte Kommentare werden automatisch zugestellt."
    }],
    "menus": {
      "editor/context": [{ "command": "localReview.addComment", "when": "(resourceScheme == file || resourceScheme == local-review-base) && isWorkspaceTrusted", "group": "navigation@20" }],
      "editor/title": [{ "command": "localReview.addComment", "when": "(resourceScheme == file || resourceScheme == local-review-base) && isWorkspaceTrusted", "group": "navigation@20" }],
      "scm/title": [{ "command": "localReview.openChanges", "when": "scmProvider == git", "group": "navigation@20" }],
      "view/title": [
        { "command": "localReview.startClaude", "when": "view == localReview.threads", "group": "navigation@1" },
        { "command": "localReview.copyClaudeCommand", "when": "view == localReview.threads", "group": "connection@1" },
        { "command": "localReview.openChanges", "when": "view == localReview.threads", "group": "navigation@2" },
        { "command": "localReview.exportToPr", "when": "view == localReview.threads", "group": "navigation@3" },
        { "command": "localReview.showResolved", "when": "view == localReview.threads && !localReview.showResolved", "group": "navigation@4" },
        { "command": "localReview.hideResolved", "when": "view == localReview.threads && localReview.showResolved", "group": "navigation@4" },
        { "command": "localReview.enhanceContrast", "when": "view == localReview.threads", "group": "navigation@5" },
        { "command": "localReview.toggleCenteredLayout", "when": "view == localReview.threads", "group": "appearance@1" },
        { "command": "localReview.resetContrast", "when": "view == localReview.threads", "group": "appearance@2" }
      ],
      "view/item/context": [
        { "command": "localReview.resolve", "when": "view == localReview.threads && viewItem == localReview.open", "group": "inline@1" },
        { "command": "localReview.reopen", "when": "view == localReview.threads && viewItem == localReview.resolved", "group": "inline@1" }
      ],
      "comments/commentThread/context": [
        { "command": "localReview.submitInline", "when": "commentController == localReview", "group": "inline@1" }
      ],
      "comments/comment/title": [
        { "command": "localReview.openCommentCode", "when": "commentController == localReview && comment == localReview.code", "group": "inline@1" }
      ],
      "comments/commentThread/title": [
        { "command": "localReview.cancelDraft", "when": "commentController == localReview && commentThreadIsEmpty", "group": "inline@1" },
        { "command": "localReview.composeReply", "when": "commentController == localReview && commentThread == localReview.open", "group": "navigation@1" },
        { "command": "localReview.resolve", "when": "commentController == localReview && commentThread == localReview.open", "group": "inline@2" },
        { "command": "localReview.reopen", "when": "commentController == localReview && commentThread == localReview.resolved", "group": "inline@1" }
      ],
      "commandPalette": [
        { "command": "localReview.openCode", "when": "false" },
        { "command": "localReview.openCommentCode", "when": "false" },
        { "command": "localReview.submitInline", "when": "false" },
        { "command": "localReview.cancelDraft", "when": "false" },
        { "command": "localReview.composeReply", "when": "false" },
        { "command": "localReview.showResolved", "when": "!localReview.showResolved" },
        { "command": "localReview.hideResolved", "when": "localReview.showResolved" },
        { "command": "localReview.resolve", "when": "false" },
        { "command": "localReview.reopen", "when": "false" },
        { "command": "localReview.revealThread", "when": "false" }
      ]
    },
    "keybindings": [{ "command": "localReview.addComment", "key": "ctrl+alt+m", "mac": "cmd+alt+m", "when": "editorTextFocus && (resourceScheme == file || resourceScheme == local-review-base)" }],
    "configuration": {
      "title": "Local Review",
      "properties": {
        "localReview.claudePath": { "type": "string", "default": "claude", "scope": "machine", "description": "Pfad zur Claude-Code-Anwendung." },
        "localReview.nodePath": { "type": "string", "default": "node", "scope": "machine", "description": "Pfad zu Node.js 22 oder neuer für die lokale Verbindung." },
        "localReview.transport": { "type": "string", "enum": ["hooks", "channels"], "default": "hooks", "description": "Automatische Zustellung im Hintergrund (Standard: hooks). channels ist eine experimentelle Alternative mit zusätzlichen Voraussetzungen." }
      }
    }
  }
}
